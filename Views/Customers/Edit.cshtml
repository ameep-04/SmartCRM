@model SmartCRM.Models.Customer
@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<h3>Edit Customer</h3>
<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="mb-3"><label>Name</label><input name="Name" value="@Model.Name" class="form-control" required /></div>
    <div class="mb-3"><label>Email</label><input name="Email" value="@Model.Email" class="form-control" /></div>
    <div class="mb-3"><label>Phone</label><input name="Phone" value="@Model.Phone" class="form-control" /></div>
    <div class="mb-3"><label>Address</label><input name="Address" value="@Model.Address" class="form-control" /></div>
    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
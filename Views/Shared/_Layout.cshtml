<!DOCTYPE html>
<html>
<head>
    <title>SmartCRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
</head>
<body>
<nav class="navbar navbar-dark bg-dark px-3">
    <span class="navbar-brand">SmartCRM</span>
    <div class="d-flex gap-3">
        <a class="text-white text-decoration-none" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <a class="text-white text-decoration-none" asp-controller="Customers" asp-action="Index">Customers</a>
        <a class="text-white text-decoration-none" asp-controller="Leads" asp-action="Index">Leads</a>
        <a class="text-white text-decoration-none" asp-controller="FollowUps" asp-action="Index">Follow-ups</a>
        <a class="text-white text-decoration-none" asp-controller="Sales" asp-action="Index">Sales</a>
        <a class="text-white text-decoration-none" asp-controller="Account" asp-action="Logout">Logout</a>
    </div>
</nav>
<div class="container mt-4">
    @RenderBody()
</div>
</body>
</html>